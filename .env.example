# Copie este arquivo para ".env" e preencha.
PORT=3000
# Exemplo local:  postgresql://postgres:senha@localhost:5432/entregafood
# Supabase/Neon:  cole a "connection string" e use DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:senha@localhost:5432/entregafood
DATABASE_SSL=false
# Troque por um texto longo e aleatório (ex.: 40+ caracteres). NUNCA publique.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
